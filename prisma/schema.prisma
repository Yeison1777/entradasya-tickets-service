generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  VALID
  CANCELLED
}

model TicketBatch {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @unique @map("order_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  sectorId   String   @map("sector_id") @db.Uuid
  quantity   Int
  issuedAt   DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)
  tickets    Ticket[]

  @@index([customerId, issuedAt])
  @@index([eventId])
  @@map("ticket_batches")
}

model Ticket {
  id       String       @id @db.Uuid
  batchId  String       @map("batch_id") @db.Uuid
  sequence Int
  code     String       @unique @db.VarChar(64)
  status   TicketStatus @default(VALID)
  pdfPath  String       @map("pdf_path") @db.VarChar(255)
  issuedAt DateTime     @default(now()) @map("issued_at") @db.Timestamptz(3)
  batch    TicketBatch  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([batchId, sequence])
  @@index([batchId])
  @@map("tickets")
}
